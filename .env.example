# App
APP_NAME="Wedding Planner"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Database (host = nazwa serwisu postgres w docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wedding
DB_USERNAME=wedding
DB_PASSWORD=secret

# Dla połączeń z hosta (DBeaver, TablePlus) użyj:
# DB_HOST=localhost
# DB_PORT=5432

# Frontend
VITE_API_BASE_URL=/api
